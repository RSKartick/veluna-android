{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated listener profile and cloud-synced Veluna preferences.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID owning this profile."
        },
        "displayName": {
          "type": "string",
          "description": "Listener display name shown in greetings and profile."
        },
        "email": {
          "type": "string",
          "description": "Google account email address."
        },
        "photoUrl": {
          "type": "string",
          "description": "Google account profile avatar URL."
        },
        "themePreset": {
          "type": "string",
          "description": "Selected theme preset identifier."
        },
        "themeMode": {
          "type": "string",
          "enum": ["DARK", "LIGHT", "SYSTEM"],
          "description": "Preferred light/dark mode."
        },
        "customAccentHex": {
          "type": "string",
          "description": "Optional custom hex accent override."
        },
        "adaptToArtwork": {
          "type": "boolean",
          "description": "Whether theme accent adapts to playing artwork."
        },
        "cornerRadiusDp": {
          "type": "integer",
          "description": "UI corner radius in dp (4..24)."
        },
        "audioQuality": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH"],
          "description": "Preferred streaming audio quality."
        },
        "autoplay": {
          "type": "boolean",
          "description": "Autoplay similar tracks."
        },
        "loudnessNormalization": {
          "type": "boolean",
          "description": "Enable loudness normalization."
        },
        "hideMusicVideos": {
          "type": "boolean",
          "description": "Prefer audio-only streams over music videos."
        },
        "selectedGenres": {
          "type": "array",
          "description": "Bounded list of up to 25 selected onboarding genre labels."
        },
        "onboardingCompleted": {
          "type": "boolean",
          "description": "Whether taste onboarding has been completed."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp written via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp written via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "userId",
        "displayName",
        "themePreset",
        "themeMode",
        "adaptToArtwork",
        "cornerRadiusDp",
        "audioQuality",
        "autoplay",
        "loudnessNormalization",
        "hideMusicVideos",
        "selectedGenres",
        "onboardingCompleted",
        "createdAt",
        "updatedAt"
      ]
    },
    "TasteSeedDoc": {
      "title": "TasteSeedDoc",
      "description": "Cloud-synced favorite artist or song taste seed with soft-delete tombstone support.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["ARTIST", "SONG"]
        },
        "name": { "type": "string" },
        "subtitle": { "type": "string" },
        "thumbnail": { "type": "string" },
        "deleted": { "type": "boolean" },
        "clientUpdatedAt": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["deleted", "clientUpdatedAt", "updatedAt"]
    },
    "LikedSongDoc": {
      "title": "LikedSongDoc",
      "description": "Cloud-synced liked song track metadata with soft-delete tombstone support.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "artists": { "type": "string" },
        "album": { "type": "string" },
        "albumId": { "type": "string" },
        "artistId": { "type": "string" },
        "duration": { "type": "string" },
        "durationSecs": { "type": "integer" },
        "thumbnail": { "type": "string" },
        "explicit": { "type": "boolean" },
        "likedAt": { "type": "integer" },
        "deleted": { "type": "boolean" },
        "clientUpdatedAt": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["deleted", "clientUpdatedAt", "updatedAt"]
    },
    "SyncedPlaylistDoc": {
      "title": "SyncedPlaylistDoc",
      "description": "Cloud-synced custom user playlist metadata (tracks stored in tracks subcollection).",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "coverUri": { "type": "string" },
        "deleted": { "type": "boolean" },
        "clientUpdatedAt": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["deleted", "clientUpdatedAt", "updatedAt"]
    },
    "SyncedPlaylistTrackDoc": {
      "title": "SyncedPlaylistTrackDoc",
      "description": "Ordered track document under /users/{uid}/playlists/{playlistKey}/tracks/{videoId}.",
      "type": "object",
      "properties": {
        "videoId": { "type": "string" },
        "title": { "type": "string" },
        "artists": { "type": "string" },
        "album": { "type": "string" },
        "albumId": { "type": "string" },
        "artistId": { "type": "string" },
        "duration": { "type": "string" },
        "durationSecs": { "type": "integer" },
        "thumbnail": { "type": "string" },
        "explicit": { "type": "boolean" },
        "position": { "type": "integer" },
        "addedAt": { "type": "integer" },
        "deleted": { "type": "boolean" },
        "clientUpdatedAt": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["deleted", "clientUpdatedAt", "updatedAt"]
    },
    "HiddenArtistDoc": {
      "title": "HiddenArtistDoc",
      "description": "Cloud-synced hidden/blocked artist record with soft-delete tombstone support.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "channelId": { "type": "string" },
        "blockedAt": { "type": "integer" },
        "deleted": { "type": "boolean" },
        "clientUpdatedAt": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["deleted", "clientUpdatedAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Authenticated user profile, preferences, and onboarding state."
    },
    "/users/{userId}/taste_seeds/{seedId}": {
      "schema": { "$ref": "#/entities/TasteSeedDoc" },
      "description": "User-selected favorite artist and song taste seeds."
    },
    "/users/{userId}/liked_songs/{videoId}": {
      "schema": { "$ref": "#/entities/LikedSongDoc" },
      "description": "Tracks liked by the authenticated user."
    },
    "/users/{userId}/playlists/{playlistKey}": {
      "schema": { "$ref": "#/entities/SyncedPlaylistDoc" },
      "description": "Custom playlists synced by the authenticated user."
    },
    "/users/{userId}/playlists/{playlistKey}/tracks/{videoId}": {
      "schema": { "$ref": "#/entities/SyncedPlaylistTrackDoc" },
      "description": "Ordered tracks belonging to a synced playlist."
    },
    "/users/{userId}/hidden_artists/{artistKey}": {
      "schema": { "$ref": "#/entities/HiddenArtistDoc" },
      "description": "Artists hidden from recommendations and autoplay."
    }
  }
}
